<mujoco model="panda planar task">
  <include file="panda.xml"/>
  <extension>
    <plugin plugin="mujoco.sdf.sdflib">
      <instance name="fmb_sdf">
        <config key="aabb" value="1"/>
      </instance>
    </plugin>
  </extension>

  <statistic center="0.3 0 0.4" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <mesh name="fmb_board" file="fmb_board.obj">
      <plugin instance="fmb_sdf"/>
    </mesh>
    <mesh name="fmb_part2" file="fmb_part2.obj">
      <plugin instance="fmb_sdf"/>
    </mesh>
    <mesh name="fmb_part3" file="fmb_part3.obj">
      <plugin instance="fmb_sdf"/>
    </mesh>
    <mesh name="fmb_part4" file="fmb_part4.obj">
      <plugin instance="fmb_sdf"/>
    </mesh>
    <mesh name="fmb_part5" file="fmb_part5.obj">
      <plugin instance="fmb_sdf"/>
    </mesh>
  </asset>

  <default>
    <default class="workpiece">
      <geom solimp="0.99 0.999 0.001" solref="0.002 1.0"
            friction="2.0 0.5 0.0001" condim="4" margin="0.0"/>
    </default>
  </default>

  <sensor>
    <force name="sensor_fts" site="sensor_fts_site"/>
  </sensor>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      From planar_scene.g (robot base at table y=-0.3, facing +Y after d(90,0,0,1)):
        .g coords -> MuJoCo coords using same transform as block task:
          mj_x = y_g + 0.3
          mj_y = -x_g

      fmb_board: g=(0, 0.10) -> mj=(0.40,  0.00)  z=0.025
      fmb_part2: g=(0.30, 0.10) -> mj=(0.40, -0.30) z=0.050
      fmb_part3: g=(0.30, 0.30) -> mj=(0.60, -0.30) z=0.019
      fmb_part4: g=(-0.30, 0.10) -> mj=(0.40,  0.30) z=0.050
      fmb_part5: g=(-0.30, 0.30) -> mj=(0.60,  0.30) z=0.050
    -->

    <!-- Main Board - centered in work zone -->
    <body name="fmb_board" pos="0.40 0.00 0.025" quat="0.707 0 0 -0.707">
      <freejoint/>
      <geom class="workpiece" type="sdf" mesh="fmb_board" rgba="0.8 0.8 0.8 1" mass="0.5"/>
    </body>

    <!-- Sub-parts in start zone -->
    <body name="fmb_part2" pos="0.40 -0.30 0.050" quat="0.707 0 0 -0.707">
      <freejoint/>
      <geom class="workpiece" type="sdf" mesh="fmb_part2" rgba="0.9 0.2 0.2 1" mass="0.1"/>
    </body>

    <body name="fmb_part3" pos="0.60 -0.30 0.019" quat="0.707 0 0 -0.707">
      <freejoint/>
      <geom class="workpiece" type="sdf" mesh="fmb_part3" rgba="0.2 0.9 0.2 1" mass="0.1"/>
    </body>

    <body name="fmb_part4" pos="0.40 0.30 0.050" quat="0.707 0 0 -0.707">
      <freejoint/>
      <geom class="workpiece" type="sdf" mesh="fmb_part4" rgba="0.2 0.2 0.9 1" mass="0.1"/>
    </body>

    <body name="fmb_part5" pos="0.60 0.30 0.050" quat="0.707 0 0 -0.707">
      <freejoint/>
      <geom class="workpiece" type="sdf" mesh="fmb_part5" rgba="0.9 0.9 0.2 1" mass="0.1"/>
    </body>

  </worldbody>
</mujoco>
