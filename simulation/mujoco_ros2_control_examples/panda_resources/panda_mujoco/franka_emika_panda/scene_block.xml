<mujoco model="panda block task">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <mesh name="tri_1_mesh" file="tri_1.obj"/>
  </asset>

  <default>
    <default class="workpiece">
      <geom solimp="0.99 0.999 0.001" solref="0.002 1.0"
            friction="2.0 0.5 0.0001" condim="4" margin="0.0"/>
    </default>
  </default>

  <sensor>
    <force name="sensor_fts" site="sensor_fts_site"/>
  </sensor>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      1:1 Digital Twin Alignment:
        Robot base is at (0, 0, 0) in both LGP and MuJoCo.
        Orientation (+X forward) is unified.
        No manual coordinate conversion required.
    -->

    <!-- === 8 RectPrisms (rotated via quat) === -->
    <body name="rect_1" pos=" 0.20 -0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba="0 .9 .9 1"  mass="0.2"/></body>
    <body name="rect_2" pos=" 0.30 -0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba="0 .7 .9 1"  mass="0.2"/></body>
    <body name="rect_3" pos=" 0.20 -0.45  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba="0 .5 1 1"   mass="0.2"/></body>
    <body name="rect_4" pos=" 0.40 -0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba=".2 .3 .9 1" mass="0.2"/></body>
    <body name="rect_5" pos=" 0.30 -0.45  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba=".9 0 .9 1"  mass="0.2"/></body>
    <body name="rect_6" pos=" 0.50 -0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba=".7 0 .9 1"  mass="0.2"/></body>
    <body name="rect_7" pos=" 0.40 -0.45  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba=".5 0 .8 1"  mass="0.2"/></body>
    <body name="rect_8" pos=" 0.50 -0.45  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.03 0.015 0.015" rgba=".3 0 .7 1"  mass="0.2"/></body>

    <!-- === 2 Cylinders === -->
    <body name="cyl_1"  pos=" 0.20  0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="cylinder" size="0.015 0.015" rgba="0 .8 0 1"   mass="0.2"/></body>
    <body name="cyl_2"  pos=" 0.30  0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="cylinder" size="0.015 0.015" rgba=".4 1 .2 1"  mass="0.2"/></body>
 
    <!-- === 4 Cubes === -->
    <body name="cube_1" pos=" 0.20  0.45  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.015 0.015 0.015" rgba="1 .5 0 1"   mass="0.2"/></body>
    <body name="cube_2" pos=" 0.40  0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.015 0.015 0.015" rgba="1 .8 0 1"   mass="0.2"/></body>
    <body name="cube_3" pos=" 0.30  0.45  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.015 0.015 0.015" rgba=".9 .3 .1 1" mass="0.2"/></body>
    <body name="cube_4" pos=" 0.50  0.30  0.015" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="box" size="0.015 0.015 0.015" rgba=".8 .1 .1 1" mass="0.2"/></body>

    <!-- === TriPrism (rotated) === -->
    <body name="tri_1"  pos=" 0.40  0.45  0.02" quat="0.707 0 0 -0.707"><freejoint/><geom class="workpiece" type="mesh" mesh="tri_1_mesh" rgba="1 .4 .7 1" mass="0.2"/></body>

  </worldbody>
</mujoco>
