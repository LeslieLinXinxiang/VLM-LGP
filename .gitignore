# === 基础忽略 (黑名单) ===
__pycache__/
*.pyc
*.o
*.a
*.exe
*.log
*.so
.DS_Store
.vscode/
.idea/
*.code-workspace

# 忽略编译目录和临时数据
build/
obj/
generated/*
!generated/.gitkeep
venv_eval/
scratch/
MUJOCO_LOG.TXT

# Track 2 baseline trial outputs: keep the structured data (trial_meta.json, .fol/.lgp/.g,
# matching the existing LGP/ trial-output convention), exclude regenerable per-trial media
# (screenshots/video/MJCF XML - large, byproduct of running the converter, not analysis input)
experiments/evaluations/Baseline_execution/**/*.png
experiments/evaluations/Baseline_execution/**/*.mp4
experiments/evaluations/Baseline_execution/**/*.xml

# === 核心豁免 (白名单 - 强制保留) ===
# 即使上面忽略了 .so 或在子目录里被忽略，也要强制保留这些：
!rai/_make/config.mk
!rai/lib/
!rai/lib/*.py
!*.h5
!bin/
!assets/
!simulation/
!LICENSE

# 排除 bin 里的可执行文件但保留源码
bin/*.exe

# === 环境变量配置 (机密) ===
.env
.env.*

# === Solver run artifacts ===
# rai/KOMO rewrites these on every run, so a tracked copy makes the working tree
# dirty after any solve. Keep them local.
z.log.*
