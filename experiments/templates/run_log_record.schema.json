{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLM-LGP Experiment Run Record",
  "type": "object",
  "required": [
    "run_id",
    "timestamp",
    "benchmark",
    "task_size_n",
    "redundancy_ratio",
    "scenario_id",
    "repeat_id",
    "random_seed",
    "method_id",
    "input_scene_g_path",
    "input_task_graph_path",
    "prompt_version",
    "code_version",
    "status",
    "failure_code",
    "failure_message",
    "solve_success",
    "task_success",
    "solver_time_sec",
    "total_time_sec",
    "predicate_count",
    "artifact_dir",
    "case_hash"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "timestamp": {"type": "string"},
    "benchmark": {"type": "string", "enum": ["cube", "fmb"]},
    "task_size_n": {"type": "integer"},
    "redundancy_ratio": {"type": "string", "enum": ["1x", "2x"]},
    "scenario_id": {"type": "string"},
    "repeat_id": {"type": "integer"},
    "random_seed": {"type": "integer"},
    "method_id": {"type": "string"},
    "input_scene_g_path": {"type": "string"},
    "input_task_graph_path": {"type": "string"},
    "prompt_version": {"type": "string"},
    "code_version": {"type": "string"},
    "status": {"type": "string", "enum": ["completed", "failed"]},
    "failure_code": {
      "type": "string",
      "enum": ["", "format_error", "syntax_error", "unsat", "timeout", "execution_fail", "infra_error"]
    },
    "failure_message": {"type": "string"},
    "solve_success": {"type": "integer", "enum": [0, 1]},
    "task_success": {"type": "integer", "enum": [0, 1]},
    "solver_time_sec": {"type": "number"},
    "total_time_sec": {"type": "number"},
    "predicate_count": {"type": "integer"},
    "artifact_dir": {"type": "string"},
    "case_hash": {"type": "string"},
    "api_model": {"type": "string"},
    "timeout_sec": {"type": "number"},
    "command": {"type": "string"},
    "notes": {"type": "string"}
  }
}
